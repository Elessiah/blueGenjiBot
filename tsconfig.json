{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Pas de `baseUrl` : TypeScript 7 l'a retiré (TS5102). `paths` se résout
    // depuis ce fichier, d'où le `./src/` explicite — lu pareil par TS 5 et 7.
    "paths": {
      "@/*": ["./src/*"]
    },

    "lib": ["ESNext"],
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "noImplicitAny": false,

    "allowJs": false,
    "checkJs": false,

    "isolatedModules": false,
    "verbatimModuleSyntax": false,

    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    "esModuleInterop": true
  },
  "include": ["src"]
}
