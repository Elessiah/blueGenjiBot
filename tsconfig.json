{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Ni `baseUrl` (retiré de TypeScript 7, TS5102) ni `paths` : les imports
    // sont relatifs, que Node résout seul — aucune réécriture après compilation.

    "lib": ["ESNext"],
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "noImplicitAny": false,

    "allowJs": false,
    "checkJs": false,

    "isolatedModules": false,
    "verbatimModuleSyntax": false,

    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    "esModuleInterop": true
  },
  "include": ["src"]
}
