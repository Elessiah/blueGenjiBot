{
  "name": "bluegenjibot",
  "version": "3.1.2",
  "type": "module",
  "main": "dist/main.js",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "moment": "^2.31.0",
    "node-cron": "^4.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^15.10.0",
    "jsdoc": "^4.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "scripts": {
    "build": "node node_modules/typescript-native/bin/tsc",
    "typecheck:ts5": "node node_modules/typescript/bin/tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "node --watch-path=src --watch-preserve-output --loader ts-node/esm src/main.ts",
    "genToken": "node dist/genToken.js",
    "lint": "eslint .",
    "docs:gen": "jsdoc -c jsdoc.json",
    "docs": "npm run build && npm run docs:gen",
    "test": "npm run build && cd dist && node --test",
    "test:coverage": "npm run build && cd dist && node --test --experimental-test-coverage"
  },
  "allowScripts": {
    "sqlite3": true,
    "unrs-resolver": false
  }
}
