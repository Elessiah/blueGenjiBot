# Configuration de scripts/backup-onedrive.sh — à copier en backup-onedrive.env
# sur le Raspberry (ce fichier-ci reste versionné, le .env ne l'est jamais).

# Base SQLite du bot.
BDD_PATH=/home/pi/blueGenjiBot/database.sqlite

# Remote rclone créé par `rclone config`, et dossier cible dans OneDrive.
RCLONE_REMOTE=onedrive
REMOTE_DIR=BlueGenji/backups

# Clé publique age (une par ligne) autorisée à déchiffrer les sauvegardes.
AGE_RECIPIENTS_FILE=/home/pi/blueGenjiBot/scripts/backup-recipients.txt

# Base MySQL du site. Laisser vide pour ne sauvegarder que la base du bot.
# Le fichier d'identifiants contient [client] / user= / password= et doit être
# en chmod 600 : mysqldump refuse le mot de passe en ligne de commande.
MYSQL_DEFAULTS_FILE=/home/pi/.mysql-backup.cnf
DB_DATABASE=appbluegenji

# Ancienneté au-delà de laquelle une sauvegarde distante est purgée.
RETENTION_DAYS=180

# Images téléversées du site (avatars, logos, photos) — `public/uploads` de
# l'app. Laisser vide pour ne pas les sauvegarder. Synchronisées en clair (elles
# sont publiques) par scripts/sync-uploads-onedrive.sh, dans
# <UPLOADS_REMOTE_DIR>/current ; les fichiers supprimés côté site partent dans
# <UPLOADS_REMOTE_DIR>/deleted/<horodatage>, purgés après UPLOADS_RETENTION_DAYS
# (défaut : RETENTION_DAYS, pour qu'un dump restauré retrouve ses images).
UPLOADS_DIR=/home/elessiah/apps/appbluegenji/public/uploads
UPLOADS_REMOTE_DIR=BlueGenji/uploads
UPLOADS_RETENTION_DAYS=180

# Fichier de statut relu par le bot pour son rapport hebdomadaire.
STATUS_FILE=/var/lib/bluegenji/backup-status.json
